{
  "name": "sketchpad-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "wasm-pack build --target web --out-dir web/pkg --release",
    "dev": "python3 -m http.server 8082 --directory web",
    "test:display": "node tests/scope-model.mjs",
    "test:pen": "node tests/pen-transport.mjs",
    "test:worker": "node tests/machine-worker.mjs",
    "test:assembly": "node tests/assembly-interaction.mjs",
    "test:circle": "CIRCLE_ONLY=1 node tests/assembly-interaction.mjs",
    "test:constraint": "CONSTRAINT_ONLY=1 node tests/assembly-interaction.mjs",
    "test:fix": "CONSTRAINT_ONLY=1 SELECT_COMMAND=3.3 node tests/assembly-interaction.mjs"
  }
}
